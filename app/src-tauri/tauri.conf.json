{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM Lens",
  "mainBinaryName": "FM Lens",
  "version": "0.7.8",
  "identifier": "local.fm.lens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FM Lens",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob: fmgfx: http://fmgfx.localhost",
        "connect-src": "ipc: http://ipc.localhost https://5om2ly4fvanjhg425jlb7s26dm0etzak.lambda-url.us-east-1.on.aws https://fm-lens-report-files-982408503112.s3.us-east-1.amazonaws.com https://us.i.posthog.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "FM Lens contributors",
    "copyright": "Copyright (C) 2026 FM Lens contributors. GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "Football Manager 27 companion",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish",
          "Spanish"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/fm-lens/icon.ico",
        "uninstallerIcon": "icons/fm-lens/icon.ico",
        "sidebarImage": "../../scripts/nsis/sidebar.bmp"
      }
    },
    "icon": [
      "icons/fm-lens/32x32.png",
      "icons/fm-lens/128x128.png",
      "icons/fm-lens/128x128@2x.png",
      "icons/fm-lens/icon.icns",
      "icons/fm-lens/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMzNCNjk4RjI1MUQyMTEKUldRUjBsSHltTFl6amdyeGM5UzBDTnJLWEFPSnhvbER0cVFXdFJWN1BCdWszaHNWK1JjVVRuYk8K",
      "endpoints": ["https://github.com/IamDejman/fm-lens-releases/releases/latest/download/latest.json"]
    }
  }
}
