{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/IamDejman/fm-lens-releases/*" },
        { "url": "https://github.com/IamDejman/fm-lens/issues/new*" }
      ]
    }
  ]
}
